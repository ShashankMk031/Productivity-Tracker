# AI Configuration Settings
# Options: 'openai' or 'gemini'
AI_PROVIDER=openai

# OpenAI API Key (Required if AI_PROVIDER is 'openai')
OPENAI_API_KEY=

# Gemini API Key (Required if AI_PROVIDER is 'gemini')
GEMINI_API_KEY=

# Model overrides (Optional)
# AI_MODEL=gpt-4o
# GEMINI_MODEL=gemini-1.5-pro
