# AI Configuration Settings
# Options: 'gemini', 'groq', 'openrouter', 'lmstudio', 'static'
AI_PROVIDER=gemini
AI_PROVIDER_ORDER=gemini,groq,openrouter,lmstudio,static

# API Keys (Provide keys for whichever providers you want active)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# LM Studio local configuration
LMSTUDIO_URL=http://localhost:1234

# Model overrides (Optional)
# GEMINI_MODEL=gemini-3.5-flash
# GROQ_MODEL=llama-3.3-70b-versatile
# OPENROUTER_MODEL=deepseek/deepseek-chat-v3
# LMSTUDIO_MODEL=google/gemma-4-12b-qat
